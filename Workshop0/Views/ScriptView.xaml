<UserControl x:Class="Workshop0.Views.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Workshop0.Views.Converters"
             xmlns:vm="clr-namespace:Workshop0.ViewModels"
             xmlns:views="clr-namespace:Workshop0.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ScriptVM, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <conv:TimeSpanBrushConverter 
        x:Key="TimeSpanBrushConverter" 
        WarningTime="0:0:20" WarningColor="Orange"
        AlertTime="0:0:40" AlertColor="LightSalmon"
        />  
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource Title1}">
                <TextBlock.Text>Détail</TextBlock.Text>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Text="{Binding User.Login, FallbackValue=(oups), TargetNullValue='(non connecté)'}"/>
            <TextBlock HorizontalAlignment="Center" 
                Text="{Binding User.LoggedDuration, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                Background="{Binding 
                    User.LoggedDuration, 
                    Converter={StaticResource TimeSpanBrushConverter},
                    FallbackValue='Coral'}"/>
            
            <Label Content="_Nom" Target="{Binding ElementName=EnteredName}"/>
            <TextBox x:Name="EnteredName" Text="{Binding Script.Name, ValidatesOnExceptions=True, Delay=1000, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="_Type" Target="{Binding ElementName=SelectedScript}"/>
            <ComboBox x:Name="SelectedScript" 
                      ItemsSource="{Binding ValidScriptTypes}" 
                      SelectedItem="{Binding Script.Type}"/>

            <Label Content="_Path" Target="{Binding ElementName=EnteredPath}"/>
            <TextBox x:Name="EnteredPath" Text="{Binding Script.Path, ValidatesOnExceptions=True, Delay=1000, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="P_arameters" Target="{Binding ElementName=Params}"/>
            <ListBox x:Name="Params"
                     IsEnabled="False"
                     ItemsSource="{Binding Script.Parameters}" 
                     DisplayMemberPath="Name"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
