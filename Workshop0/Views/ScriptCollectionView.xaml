<UserControl x:Class="Workshop0.Views.ScriptCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dbg="clr-namespace:System.Diagnostics;assembly=WindowsBase"
             xmlns:cmd="clr-namespace:Workshop0.ViewModels.Commands"
             xmlns:models="clr-namespace:Workshop0.Models"
             xmlns:vm="clr-namespace:Workshop0.ViewModels"
             xmlns:views="clr-namespace:Workshop0.Views"
             xmlns:conv="clr-namespace:Workshop0.Views.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ScriptCollectionVM, IsDesignTimeCreatable=False}"
             >
    <UserControl.Resources>
        <conv:SpyConverter x:Key="spy"/>
        <conv:TimeSpanBrushConverter 
        x:Key="TimeSpanBrushConverter" 
        WarningTime="0:0:20" WarningColor="Orange"
        AlertTime="0:0:40" AlertColor="LightSalmon"
        />
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="cmd:ScriptOps.New"    Executed="New_Executed"    CanExecute="New_CanExecute"/>
        <CommandBinding Command="cmd:ScriptOps.Open"   Executed="Open_Executed"   CanExecute="Open_CanExecute"/>
        <CommandBinding Command="cmd:ScriptOps.ImportDb" Executed="ImportDb_Executed" CanExecute="ImportDb_CanExecute"/>
        <CommandBinding Command="cmd:ScriptOps.ExportDb" Executed="ExportDb_Executed" CanExecute="ExportDb_CanExecute"/>
        <CommandBinding Command="cmd:ScriptOps.Filter" Executed="Filter_Executed" CanExecute="Filter_CanExecute"/>
    </UserControl.CommandBindings>
    <Grid ColumnDefinitions="20*, 40*">
        <!--#region Left-->
        <TreeView Grid.Row="0" Grid.Column="0" ItemsSource="{Binding ScriptColl.Scripts}"
         dbg:PresentationTraceSources.TraceLevel="High">
            <TreeView.Resources>
                <HierarchicalDataTemplate 
                DataType="{x:Type models:Script}"
                ItemsSource="{Binding Parameters}"
                >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" Foreground="Gray"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type models:ScriptParameter}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat='{}{0} = "{1}"'>
                                <Binding Path="Name"/>
                                <Binding Path="Value"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
        <!--#endregion-->
        <!--#region Right-->
        <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="auto,*">
            <Grid.CommandBindings>
                <CommandBinding 
            Command="ApplicationCommands.Cut" 
            Executed="ScriptCut_Executed"
            CanExecute="ScriptCut_CanExecute"/>
            </Grid.CommandBindings>
            <ComboBox x:Name="FilterCtrl"
                    ItemsSource="{Binding ScriptTypes}" 
                    SelectedItem="{Binding SelectedFilter}" />
            <!--TextBlock Text="{Binding SelectedItem.Path, ElementName=FilterCtrl}"/-->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding FilteredScripts}" 
                      SelectedItem="{Binding SelectedScript}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Path">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" FontFamily="Courier New"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>
        <!--#endregion-->
        <GridSplitter Grid.Row ="1" Grid.Column="0" 
              ResizeDirection="Columns"/>
    </Grid>
</UserControl>
