<Window x:Class="Workshop0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Workshop0"
        xmlns:dbg="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Window.Resources>
        <local:SpyConverter x:Key="spy"/>
        <local:TimeSpanBrushConverter 
            x:Key="TimeSpanBrushConverter" 
            WarningTime="0:0:20" WarningColor="Orange"
            AlertTime="0:0:40" AlertColor="LightSalmon"
            />
        <!--CollectionViewSource Source="{Binding ScriptColl.Scripts}" 
                              x:Key="FilteredScripts"
                              IsLiveGroupingRequested="True">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Type"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource-->
    </Window.Resources>
    <Window.Title>
        <Binding 
            Path="User.Login" 
            StringFormat="{}Workshop 0 ({0})" 
            TargetNullValue="Workshop0 (non connecté)"
            dbg:PresentationTraceSources.TraceLevel="High"/>
    </Window.Title>
    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding FileQuit}"/>
    </Window.InputBindings>
    <Grid ColumnDefinitions="25*, 50*, 25*" RowDefinitions="auto,*,auto">
        <Menu Grid.ColumnSpan="3">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau" Command="{Binding FileNew}"/>
                <MenuItem Header="_Ouvrir" Command="{Binding FileOpen}"/>
                <Separator/>
                <MenuItem 
                    Header="_Quitter" 
                    InputGestureText="Ctrl+Q"
                    Command="{Binding FileQuit}" CommandParameter=""
                    />
            </MenuItem>
            <MenuItem Header="_?">
                <MenuItem Header="_A propose de..."/>
            </MenuItem>
        </Menu>
        <TreeView Grid.Row="1" Grid.Column="0" 
                 ItemsSource="{Binding ScriptColl.Scripts}"
                  dbg:PresentationTraceSources.TraceLevel="High">
            <TreeView.Resources>
                <HierarchicalDataTemplate 
                    DataType="{x:Type local:Script}"
                    ItemsSource="{Binding Parameters}"
                    >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" Foreground="Gray"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type local:ScriptParameter}">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat='{}{0} = "{1}"'>
                                <Binding Path="Name"/>
                                <Binding Path="Value"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
        <Grid Grid.Column="1" Grid.Row="1" RowDefinitions="auto,*">
            <ComboBox x:Name="FilterCtrl"
                ItemsSource="{Binding ScriptTypes}" 
                SelectedItem="{Binding SelectedFilter}" />
            <!--TextBlock Text="{Binding SelectedItem.Path, ElementName=FilterCtrl}"/-->
            <ListView Grid.Row="1" ItemsSource="{Binding FilteredScripts}" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Path">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" FontFamily="Courier New"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn> 
                    </GridView>
                </ListView.View>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>
        <GridSplitter Grid.Row ="1" Grid.Column="0" 
                      ResizeDirection="Columns"/>
        <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Title1}">
                    <TextBlock.Text>Détail</TextBlock.Text>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Text="{Binding User.Login, FallbackValue=(oups), TargetNullValue='(non connecté)'}"/>
                <TextBlock HorizontalAlignment="Center" 
                           Text="{Binding User.LoggedDuration, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                           Background="{Binding 
                                User.LoggedDuration, 
                                Converter={StaticResource TimeSpanBrushConverter},
                                FallbackValue='Coral'}"/>
                <Label Content="Nom"/>
                <TextBox Text="{Binding User.Login, Delay=1000, UpdateSourceTrigger=PropertyChanged}" x:Name="EnteredName"/>
                <Label Content="Type"/>
                <ComboBox ItemsSource="{Binding ValidScriptTypes}"/>
            </StackPanel>
        </ScrollViewer>
        <GridSplitter Grid.Row ="1" Grid.Column="1" 
            ResizeDirection="Columns"/>
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3">
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock>Prêt</TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" Value="50"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
