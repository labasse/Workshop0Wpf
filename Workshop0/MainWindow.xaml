<Window x:Class="Workshop0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Workshop0"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Window.Resources>
        <local:User x:Key="user" Login="???" x:Name="user" />
    </Window.Resources>
    <Window.Title>
        <Binding Path="Login" Source="{StaticResource user}" StringFormat="{}Workshop 0 ({0})"/>
    </Window.Title>
    <Grid ColumnDefinitions="25*, 50*, 25*" RowDefinitions="auto,*,auto">
        <Menu Grid.ColumnSpan="3">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau" Click="MenuFileNew_Click"/>
                <Separator/>
                <MenuItem 
                    Header="_Quitter" 
                    InputGestureText="Ctrl+Q"
                    Click="MenuFileQuit_Click"
                    />
            </MenuItem>
            <MenuItem Header="_?">
                <MenuItem Header="_A propose de..."/>
            </MenuItem>
        </Menu>
        <TreeView Grid.Row="1" Grid.Column="0">
            <TreeViewItem Header="Dossier 1">
                <TreeViewItem Header="Fichier 1"/>
                <TreeViewItem Header="Fichier 2"/>
            </TreeViewItem>
            <TreeViewItem Header="Dossier 2">
                <TreeViewItem Header="Fichier 3"/>
                <TreeViewItem Header="Fichier 4"/>
            </TreeViewItem>
        </TreeView>
        <ListView Grid.Column="1" Grid.Row="1"></ListView>
        <GridSplitter Grid.Row ="1" Grid.Column="0" 
                      ResizeDirection="Columns"/>
        <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{StaticResource user}">
                <TextBlock Style="{StaticResource Title1}">
                    <TextBlock.Text>Détail</TextBlock.Text>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Text="{Binding Login, FallbackValue=(oups), TargetNullValue='(non connecté)'}"/>
                <TextBlock HorizontalAlignment="Center" Text="{Binding LoggedDuration, StringFormat='{}{0:hh\\:mm\\:ss}'}"/>
                <Label Content="Nom"/>
                <TextBox Text="{Binding Login, Delay=1000, UpdateSourceTrigger=PropertyChanged}" x:Name="EnteredName"/>
                <Label Content="Type"/>
                <ComboBox/>
            </StackPanel>
        </ScrollViewer>
        <GridSplitter Grid.Row ="1" Grid.Column="1" 
            ResizeDirection="Columns"/>
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3">
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock>Prêt</TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" Value="50"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
